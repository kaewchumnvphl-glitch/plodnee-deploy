# Copy to .env locally; set these as environment variables on Render.

# Required: signs trial/license tokens. Never change after launch.
LICENSE_SECRET="replace-with-a-long-random-secret-at-least-16-chars"

# Required: password for /admin (at least 8 characters).
ADMIN_SECRET="replace-with-a-long-random-admin-password"

# Set by Render; local default is 10000.
PORT="10000"
NODE_ENV="production"

# Public URL after deploy.
APP_URL="https://plodnee-planner.onrender.com"

# Optional durable storage. Without these, data is written to .plodnee-data/
# and lost whenever Render restarts/redeploys.
GITHUB_STORE_TOKEN=""
GITHUB_STORE_REPO=""
GITHUB_STORE_BRANCH="data-store"
GITHUB_STORE_PATH="secure-store.json"

# Optional LINE OA Messaging API push notifications.
# LINE_NOTIFY_TO accepts comma-separated user/group/room IDs (max 5).
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_NOTIFY_TO=""
